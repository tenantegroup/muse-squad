#!/usr/bin/env bash
# muse-squad installer - GENERATED FILE, DO NOT EDIT BY HAND.
# Source of truth: payload/ + scripts/generate-installers.sh
set -euo pipefail

VERSION=0.3.0
CONFIG_DIR="${MUSE_CONFIG_DIR:-${HOME}/.config/muse}"
CONFIG_DIR_EXPLICIT=0
[[ -n "${MUSE_CONFIG_DIR:-}" ]] && CONFIG_DIR_EXPLICIT=1
MODE="install"
SKIP_MCP=0
SKIP_MUSE_CHECK=0
BACKUP_CHOICE="auto"
RECONFIGURE_TEAM=0
USE_DEFAULTS=0
LEGACY_CONFIG=0
MIGRATE_TEAM=0
REPO_RAW_BASE="https://raw.githubusercontent.com/tenantegroup/muse-squad/main"
MUSE_SQUAD_STATE_FILE="${HOME}/.config/muse-squad/config-dir"

usage() {
  cat <<'USAGE'
muse-squad installer

Usage:
  curl -fsSL https://raw.githubusercontent.com/tenantegroup/muse-squad/main/install | bash
  bash install [--dir PATH] [--update] [--uninstall] [--no-mcp] [--help]
  bash install [--reconfigure-team] [--defaults] [--skip-muse-check]

Options:
  --dir PATH          Install into PATH instead of $HOME/.config/muse
  --update            Download and run the latest installer from GitHub, then install
  --uninstall         Remove managed files and unregister muse-squad
  --no-mcp            Skip muse-squad MCP registration
  --backup            Force a backup prompt/backup
  --no-backup         Skip the backup prompt and backup
  --reconfigure-team  Rerun the interactive team wizard on an existing install
  --defaults          Skip the team wizard and use the default roster
  --skip-muse-check   Skip Muse install/config discovery
  --help, -h          Show this help

Environment:
  MUSE_CONFIG_DIR          Equivalent to --dir (useful with curl | bash)
  MUSE_SQUAD_SKIP_MCP      Set to 1 to skip MCP registration
  MUSE_SQUAD_NO_BACKUP     Set to 1 to skip backup unless --backup is passed
  MUSE_SQUAD_SKIP_MUSE_CHECK Set to 1 to skip Muse install/config discovery
  MUSE_SQUAD_FORCE_INTERACTIVE Set to 1 to attempt prompts even without a TTY
  MUSE_SQUAD_TTY           Terminal device for prompts (default /dev/tty or CONIN$)

Providers and squad members are configured in muse-squad.toml inside the config directory.
USAGE
}

log()  { printf '%s\n' "$*"; }
fail() { printf 'error: %s\n' "$*" >&2; exit 1; }

while (( $# > 0 )); do
  case "$1" in
    --dir)
      (( $# >= 2 )) || fail "--dir requires a value"
      CONFIG_DIR="$2"; CONFIG_DIR_EXPLICIT=1; shift 2 ;;
    --update) MODE="update"; shift ;;
    --uninstall) MODE="uninstall"; shift ;;
    --no-mcp) SKIP_MCP=1; shift ;;
    --backup) BACKUP_CHOICE="yes"; shift ;;
    --no-backup) BACKUP_CHOICE="no"; shift ;;
    --reconfigure-team) RECONFIGURE_TEAM=1; shift ;;
    --defaults) USE_DEFAULTS=1; shift ;;
    --skip-muse-check) SKIP_MUSE_CHECK=1; shift ;;
    -h|--help) usage; exit 0 ;;
    *) fail "unknown option: $1" ;;
  esac
done

if [[ "$BACKUP_CHOICE" == "auto" && "${MUSE_SQUAD_NO_BACKUP:-0}" == "1" ]]; then
  BACKUP_CHOICE="no"
fi
if [[ "${MUSE_SQUAD_SKIP_MUSE_CHECK:-0}" == "1" ]]; then
  SKIP_MUSE_CHECK=1
fi
while [[ "$CONFIG_DIR" == */ && "$CONFIG_DIR" != "/" ]]; do
  CONFIG_DIR="${CONFIG_DIR%/}"
done

# fd 0 is the installer script when it is piped in, so prompts must use the
# controlling terminal instead. MUSE_SQUAD_TTY exists for automation/tests.
MUSE_SQUAD_TTY="${MUSE_SQUAD_TTY:-/dev/tty}"
MUSE_SQUAD_TTY_LINE=1
export MUSE_SQUAD_TTY MUSE_SQUAD_TTY_LINE

tty_readable() {
  ( : < "$MUSE_SQUAD_TTY" ) 2>/dev/null
}

# A regular-file override is used by tests; read it one line at a time. A real
# terminal keeps its input queue across open/read/close, so reopen it per prompt.
read_tty_value() {
  local __var="$1" value=""
  if [[ -f "$MUSE_SQUAD_TTY" ]]; then
    if ! value="$(awk -v n="$MUSE_SQUAD_TTY_LINE" \
      'NR == n { print; found = 1; exit } END { if (!found) exit 1 }' \
      "$MUSE_SQUAD_TTY" 2>/dev/null)"; then
      return 1
    fi
    MUSE_SQUAD_TTY_LINE=$((MUSE_SQUAD_TTY_LINE + 1))
  else
    IFS= read -r value < "$MUSE_SQUAD_TTY" || return 1
  fi
  printf -v "$__var" '%s' "$value"
}

interactive_input() {
  [[ "${MUSE_SQUAD_FORCE_INTERACTIVE:-0}" == "1" ]] && return 0
  [[ -t 0 ]] && return 0
  tty_readable
}

read_answer() {
  local __var="$1" __value=""
  if [[ -t 0 ]]; then
    IFS= read -r __value || return 1
  elif tty_readable; then
    read_tty_value __value || return 1
  else
    # Forced-interactive automation may feed answers on stdin.
    IFS= read -r __value || return 1
  fi
  printf -v "$__var" '%s' "$__value"
}

read_default() {
  local __var="$1" __default="${2-}" value=""
  if read_answer value && [[ -n "$value" ]]; then
    printf -v "$__var" '%s' "$value"
  else
    printf -v "$__var" '%s' "$__default"
  fi
}

preflight_interactive() {
  interactive_input
}

muse_missing_error() {
  fail "Muse Code was not found. Install it with 'curl -fsSL https://dev.meta.ai/install.sh | bash' (macOS/Linux) or 'irm https://dev.meta.ai/install.ps1 | iex' (Windows), then re-run. Pass --skip-muse-check to bypass."
}

muse_installed() {
  if command -v muse >/dev/null 2>&1 && muse --version >/dev/null 2>&1; then
    return 0
  fi
  local candidate
  for candidate in \
    "$HOME/.local/bin/muse" \
    "/usr/local/bin/muse" \
    "/opt/homebrew/bin/muse" \
    "/Applications/Muse Code.app/Contents/MacOS/muse"; do
    [[ -x "$candidate" ]] || continue
    if "$candidate" --version >/dev/null 2>&1; then
      return 0
    fi
  done
  return 1
}

install_muse() {
  command -v curl >/dev/null 2>&1 || fail "curl is required to run the official Muse Code installer"
  log "  installing  Muse Code via the official installer"
  if ! curl -fsSL https://dev.meta.ai/install.sh | bash; then
    fail "the Muse Code installer failed; see https://dev.meta.ai/docs/muse-code"
  fi
}

read_saved_config_dir() {
  local saved=""
  [[ -f "$MUSE_SQUAD_STATE_FILE" ]] || return 0
  IFS= read -r saved < "$MUSE_SQUAD_STATE_FILE" || true
  saved="${saved%$'\r'}"
  [[ -n "$saved" ]] && printf '%s' "$saved"
}

save_config_dir() {
  local dest="$MUSE_SQUAD_STATE_FILE"
  mkdir -p "$(dirname "$dest")" || fail "cannot create directory for $dest"
  printf '%s\n' "$1" > "$dest" || fail "cannot write $dest"
  chmod 600 "$dest" || fail "cannot set permissions on $dest"
}

migration_state_file() {
  printf '%s' "$CONFIG_DIR/.muse-squad-state.json"
}

state_json_value() {
  local key="$1" file value=""
  file="$(migration_state_file)"
  [[ -f "$file" ]] || { printf '%s' "$value"; return 0; }
  value="$(awk -v key="\"$key\"" '
    index($0, key) {
      line = $0
      sub(/^[^:]*:[[:space:]]*"/, "", line)
      sub(/".*$/, "", line)
      print line
      exit
    }
  ' "$file" 2>/dev/null)" || true
  printf '%s' "$value"
}

write_migration_state() {
  local status="$1" file tmp
  file="$(migration_state_file)"
  mkdir -p "$(dirname "$file")" || fail "cannot create directory for $file"
  tmp="$(mktemp "${TMPDIR:-/tmp}/muse-squad-state.XXXXXX")" || fail "mktemp failed"
  cat > "$tmp" <<EOF
{
  "version": "$VERSION",
  "migrationStatus": "$status"
}
EOF
  chmod 600 "$tmp" || fail "cannot set permissions on $file"
  mv "$tmp" "$file" || fail "cannot write $file"
  log "  state       $file ($status)"
}

state_handled_for_current() {
  local state_version status
  state_version="$(state_json_value version)"
  status="$(state_json_value migrationStatus)"
  [[ "$state_version" == "$VERSION" ]] || return 1
  [[ "$status" == "applied" || "$status" == "declined" ]]
}

config_has_version_marker() {
  local dest="$CONFIG_DIR/muse-squad.toml"
  [[ -f "$dest" ]] && grep -qF "# muse-squad-version: $VERSION" "$dest"
}

offer_migration() {
  (( LEGACY_CONFIG )) || return 0
  [[ "$MODE" == "install" ]] || return 0

  if state_handled_for_current; then
    log "  skipped    migration (state: $(state_json_value migrationStatus))"
    return 0
  fi
  if (( USE_DEFAULTS )); then
    write_migration_state declined
    log "  skipped    migration (--defaults)"
    return 0
  fi
  if ! interactive_input; then
    log "  available  role-catalog migration; re-run with --reconfigure-team"
    return 0
  fi

  write_migration_state offered
  local answer="N"
  printf 'Older squad config detected. Migrate to the role-catalog templates now? [y/N]: ' >&2
  read_default answer "N"
  case "$answer" in
    [Yy]|[Yy][Ee][Ss])
      MIGRATE_TEAM=1
      log "  migration  starting role-catalog wizard"
      ;;
    ''|[Nn]|[Nn][Oo])
      write_migration_state declined
      log "  kept       $CONFIG_DIR/muse-squad.toml (migration declined)"
      ;;
    *)
      fail "expected y or n for migration prompt" ;;
  esac
}

valid_muse_config_dir() {
  local dir="$1" marker
  [[ -d "$dir" ]] || return 1
  for marker in settings.json auth.json trust.json agents skills mcp; do
    [[ -e "$dir/$marker" ]] && return 0
  done
  return 1
}

expand_user_path() {
  local value="$1"
  case "$value" in
    "~"|"~/"*) value="$HOME${value#\~}" ;;
  esac
  printf '%s' "$value"
}

preflight() {
  (( SKIP_MUSE_CHECK )) && { log "  skipped    Muse preflight"; return 0; }

  if ! muse_installed; then
    if preflight_interactive; then
      local answer
      printf 'Muse Code does not appear to be installed. Install it now? [Y/n]: ' >&2
      read_default answer "Y"
      case "$answer" in
        [Yy]|[Yy][Ee][Ss]) install_muse ;;
        [Nn]|[Nn][Oo]) muse_missing_error ;;
        *) fail "expected Y or n for the Muse Code install prompt" ;;
      esac
      if ! muse_installed; then
        fail "Muse Code was still not found after installation. Open a new terminal and re-run this installer."
      fi
    else
      muse_missing_error
    fi
  fi

  if (( CONFIG_DIR_EXPLICIT )); then
    log "  using      $CONFIG_DIR (explicit)"
    return 0
  fi

  local -a candidates=()
  local saved candidate typed
  saved="$(read_saved_config_dir || true)"
  [[ -n "$saved" ]] && candidates+=("$saved")
  if [[ -n "${XDG_CONFIG_HOME:-}" ]]; then
    candidates+=("$XDG_CONFIG_HOME/muse")
  fi
  candidates+=("$HOME/.config/muse" "$HOME/.muse")
  [[ -n "${APPDATA:-}" ]] && candidates+=("$APPDATA/muse")
  [[ -n "${LOCALAPPDATA:-}" ]] && candidates+=("$LOCALAPPDATA/muse")

  for candidate in "${candidates[@]}"; do
    if valid_muse_config_dir "$candidate"; then
      CONFIG_DIR="$candidate"
      log "  found      Muse config at $CONFIG_DIR"
      return 0
    fi
  done

  if preflight_interactive; then
    while :; do
      printf 'Where is your Muse config directory? ' >&2
      read_answer typed || fail "no Muse config directory was supplied"
      typed="$(expand_user_path "$(trim_value "$typed")")"
      if valid_muse_config_dir "$typed"; then
        CONFIG_DIR="$typed"
        save_config_dir "$CONFIG_DIR"
        log "  using      Muse config at $CONFIG_DIR"
        log "  saved      $MUSE_SQUAD_STATE_FILE"
        return 0
      fi
      printf '  not a Muse config directory (need settings.json, auth.json, trust.json, agents/, skills/, or mcp/)\n' >&2
    done
  fi

  fail "could not find a Muse config directory. Pass --dir PATH, set MUSE_CONFIG_DIR, or re-run in a terminal."
}

backup_config() {
  [[ -d "$CONFIG_DIR" ]] || { log "  skip backup  no existing config dir"; return 0; }

  if [[ "$BACKUP_CHOICE" == "no" ]]; then
    log "  skipped      backup (--no-backup)"
    return 0
  fi

  local answer="Y"
  if interactive_input; then
    printf 'Back up current Muse config before continuing? [Y/n]: ' >&2
    read_default answer "Y"
  else
    log "  no interactive terminal detected; backing up by default"
  fi

  case "$answer" in
    ''|[Yy]|[Yy][Ee][Ss]) ;;
    [Nn]|[Nn][Oo])
      log "  skipped      backup (user chose no)"
      return 0 ;;
    *)
      fail "expected Y or n for backup prompt" ;;
  esac

  local stamp backup
  stamp="$(date +%Y%m%d-%H%M%S)-$$"
  backup="${CONFIG_DIR}.backup.${stamp}"
  mkdir -p "$backup" || fail "cannot create backup dir $backup"
  chmod 700 "$backup" || fail "cannot secure backup dir $backup"
  cp -a "$CONFIG_DIR/." "$backup/" || fail "cannot back up $CONFIG_DIR to $backup"
  log "  backed up    $CONFIG_DIR -> $backup"
  log "  restore      $backup"
}

install_file() {
  local rel="$1" dest="$CONFIG_DIR/$1" tmp bak
  mkdir -p "$(dirname "$dest")" || fail "cannot create directory for $dest"
  tmp="$(mktemp "${TMPDIR:-/tmp}/muse-squad.XXXXXX")" || fail "mktemp failed"
  cat > "$tmp"
  if [[ -f "$dest" ]]; then
    if cmp -s "$tmp" "$dest" || diff -q --strip-trailing-cr "$tmp" "$dest" >/dev/null 2>&1; then
      rm -f "$tmp"; log "  unchanged  $dest"; return 0
    fi
  fi
  if [[ -f "$dest" ]]; then
    bak="${dest}.bak.$(date +%Y%m%d%H%M%S)"
    mv "$dest" "$bak" || fail "cannot back up $dest"
    log "  backed up  $dest -> $bak"
  fi
  mv "$tmp" "$dest" || fail "cannot install $dest"
  log "  installed  $dest"
}

uninstall_file() {
  local dest="$CONFIG_DIR/$1"
  if [[ -f "$dest" ]]; then
    rm -f "$dest" || fail "cannot remove $dest"
    log "  removed    $dest"
  fi
}

AGENTS_BEGIN='<!-- muse-squad:begin -->'
AGENTS_END='<!-- muse-squad:end -->'

policy_target() {
  if [[ -f "$CONFIG_DIR/AGENTS.md" ]]; then
    printf '%s\n' "$CONFIG_DIR/AGENTS.md"
  elif [[ -f "$CONFIG_DIR/MUSE.md" ]]; then
    printf '%s\n' "$CONFIG_DIR/MUSE.md"
  else
    printf '%s\n' "$CONFIG_DIR/AGENTS.md"
  fi
}

trim_trailing_newlines() {
  local value="$1"
  while [[ "$value" == *$'\n' ]]; do value="${value%$'\n'}"; done
  printf '%s' "$value"
}

install_agents_policy() {
  local dest content existing updated before after bak
  dest="$(policy_target)"
  content="$(cat)"
  mkdir -p "$(dirname "$dest")" || fail "cannot create directory for $dest"
  existing=""
  if [[ -f "$dest" ]]; then existing="$(cat "$dest")"; fi

  if [[ "$existing" == *"$AGENTS_BEGIN"* || "$existing" == *"$AGENTS_END"* ]]; then
    if [[ "$existing" != *"$AGENTS_BEGIN"*"$AGENTS_END"* ||
          "$existing" == *"$AGENTS_END"*"$AGENTS_BEGIN"* ]]; then
      log "  warning    $dest has a partial or reordered muse-squad block; left unchanged"
      return 0
    fi
    before="${existing%%$AGENTS_BEGIN*}"
    after="${existing#*$AGENTS_END}"
    updated="$(trim_trailing_newlines "$before")${content}$(trim_trailing_newlines "$after")"
  elif [[ -n "$existing" ]]; then
    updated="$(trim_trailing_newlines "$existing")"$'\n\n'"${content}"
  else
    updated="${content}"
  fi
  updated="$(trim_trailing_newlines "$updated")"$'\n'

  if [[ -f "$dest" ]] && cmp -s <(printf '%s' "$updated") "$dest"; then
    log "  unchanged  $dest"
    return 0
  fi
  if [[ -f "$dest" ]]; then
    bak="${dest}.bak.$(date +%Y%m%d%H%M%S)"
    mv "$dest" "$bak" || fail "cannot back up $dest"
    log "  backed up  $dest -> $bak"
  fi
  printf '%s' "$updated" > "$dest" || fail "cannot install $dest"
  log "  installed  $dest"
}

uninstall_agents_policy() {
  local dest existing before after updated
  for dest in "$CONFIG_DIR/AGENTS.md" "$CONFIG_DIR/MUSE.md"; do
    [[ -f "$dest" ]] || continue
    existing="$(cat "$dest")"
    if [[ "$existing" != *"$AGENTS_BEGIN"* || "$existing" != *"$AGENTS_END"* ]]; then
      continue
    fi
    if [[ "$existing" == *"$AGENTS_END"*"$AGENTS_BEGIN"* ]]; then
      log "  warning    $dest has a reordered muse-squad block; left unchanged"
      continue
    fi
    before="$(trim_trailing_newlines "${existing%%$AGENTS_BEGIN*}")"
    after="$(trim_trailing_newlines "${existing#*$AGENTS_END}")"
    if [[ -n "$before" && -n "$after" ]]; then
      updated="${before}"$'\n\n'"${after}"$'\n'
    elif [[ -n "$before" ]]; then
      updated="${before}"$'\n'
    elif [[ -n "$after" ]]; then
      updated="${after}"$'\n'
    else
      rm -f "$dest" || fail "cannot remove $dest"
      log "  removed    $dest"
      continue
    fi
    printf '%s' "$updated" > "$dest" || fail "cannot update $dest"
    log "  updated    $dest"
  done
}

install_config() {
  local dest="$CONFIG_DIR/muse-squad.toml" tmp
  if [[ -f "$dest" ]]; then
    log "  unchanged  $dest"
    return 0
  fi
  mkdir -p "$(dirname "$dest")" || fail "cannot create directory for $dest"
  tmp="$(mktemp "${TMPDIR:-/tmp}/muse-squad-config.XXXXXX")" || fail "mktemp failed"
  cat > "$tmp"
  chmod 600 "$tmp" || fail "cannot set permissions on $dest"
  mv "$tmp" "$dest" || fail "cannot install $dest"
  log "  created    $dest"
}

wizard_interactive() {
  [[ "$MODE" == "install" ]] || return 1
  (( USE_DEFAULTS )) && return 1
  interactive_input
}

configure_team() {
  local dest="$CONFIG_DIR/muse-squad.toml" seeded=0 config_before=""

  if (( FIRST_INSTALL )); then
    # Seed first so the shared role wizard has providers to assign.
    if [[ ! -f "$dest" ]]; then
      install_default_config
      seeded=1
    fi
  elif (( ! MIGRATE_TEAM && ! RECONFIGURE_TEAM )); then
    log "  unchanged  $dest"
    return 0
  fi

  if ! wizard_interactive; then
    if (( MIGRATE_TEAM || RECONFIGURE_TEAM )); then
      log "  unchanged  $dest (team wizard skipped)"
    fi
    return 0
  fi
  if ! command -v node >/dev/null 2>&1; then
    log "  warning    node not found; keeping existing team config"
    return 0
  fi

  if (( ! MIGRATE_TEAM )); then
    local customize_answer="Y"
    printf 'Customize Squad team members & models now? [Y/n]: ' >&2
    read_default customize_answer "Y"
    case "$customize_answer" in
      [Yy]|[Yy][Ee][Ss]) ;;
      [Nn]|[Nn][Oo])
        if (( seeded )); then
          log "  kept defaults  $dest"
        else
          log "  unchanged  $dest"
        fi
        return 0 ;;
      *)
        fail "expected Y or n for team customization prompt" ;;
    esac
  fi

  config_before="$(mktemp "${TMPDIR:-/tmp}/muse-squad-config-before.XXXXXX")" || fail "mktemp failed"
  cp "$dest" "$config_before" 2>/dev/null || true

  local wizard="$CONFIG_DIR/mcp/team-wizard.js" members_file providers_file config_tmp
  members_file="$(mktemp "${TMPDIR:-/tmp}/muse-squad-members.XXXXXX")" || fail "mktemp failed"
  providers_file="${members_file}.providers"
  config_tmp="$(mktemp "${TMPDIR:-/tmp}/muse-squad-config.XXXXXX")" || fail "mktemp failed"

  # If prompts come from a terminal device, let the Node wizard keep reading
  # from that same source. For a regular-file TTY override, pass the next line
  # so the wizard does not replay answers already consumed by the installer.
  if tty_readable; then
    export MUSE_SQUAD_WIZARD_INPUT="$MUSE_SQUAD_TTY"
    export MUSE_SQUAD_WIZARD_LINE="$MUSE_SQUAD_TTY_LINE"
  else
    unset MUSE_SQUAD_WIZARD_INPUT MUSE_SQUAD_WIZARD_LINE
  fi

  local -a wizard_args=(--config "$dest" --members-file "$members_file")
  (( FIRST_INSTALL )) && wizard_args+=(--fresh)
  if ! node "$wizard" "${wizard_args[@]}"; then
    rm -f "$members_file" "$providers_file" "$config_tmp" "$config_before"
    fail "team configuration failed"
  fi
  if ! node "$wizard" --render "$dest" --members-file "$members_file" > "$config_tmp"; then
    rm -f "$members_file" "$providers_file" "$config_tmp" "$config_before"
    fail "team config generation failed"
  fi
  if ! node "$CONFIG_DIR/mcp/config.js" --file "$config_tmp" --json >/dev/null 2>&1; then
    rm -f "$members_file" "$providers_file" "$config_tmp" "$config_before"
    fail "team config failed validation; no changes were written"
  fi
  mv "$config_tmp" "$dest" || fail "cannot install $dest"
  chmod 600 "$dest" 2>/dev/null || true
  rm -f "$members_file" "$providers_file"
  log "  updated    $dest"

  if (( LEGACY_CONFIG )); then
    if cmp -s "$config_before" "$dest"; then
      write_migration_state declined
      log "  unchanged  $dest (migration kept current squad)"
    else
      write_migration_state applied
    fi
  fi
  rm -f "$config_before"
}

run_sync_team() {
  local action="$1" script="$CONFIG_DIR/mcp/sync-team.js"
  if ! command -v node >/dev/null 2>&1; then
    log "  warning    node not found on PATH; skipping team materialization"
    return 0
  fi
  if [[ ! -f "$script" ]]; then
    log "  warning    $script missing; skipping team materialization"
    return 0
  fi
  local -a args=("$script" --config-dir "$CONFIG_DIR")
  if [[ "$action" == "uninstall" ]]; then
    args+=(--uninstall)
  fi
  node "${args[@]}" || fail "team materialization failed"
}

register_mcp() {
  local action="$1" registrar="$CONFIG_DIR/mcp/register-settings.js"
  if (( SKIP_MCP )) || [[ "${MUSE_SQUAD_SKIP_MCP:-0}" == "1" ]]; then
    log "  skipped    MCP registration"
    return 0
  fi
  if ! command -v node >/dev/null 2>&1; then
    log "  warning    node not found on PATH; skipping MCP registration"
    return 0
  fi
  local node_major
  node_major="$(node -p 'process.versions.node.split(".")[0]' 2>/dev/null || printf '0')"
  if [[ "$node_major" =~ ^[0-9]+$ ]] && (( node_major < 18 )); then
    log "  warning    node $node_major is too old; MCP bridge requires Node 18+"
  fi
  if [[ ! -f "$registrar" ]]; then
    log "  warning    $registrar missing; skipping MCP registration"
    return 0
  fi
  local -a args=(--settings "$CONFIG_DIR/settings.json" --bridge "$CONFIG_DIR/mcp/bridge.js")
  if [[ "$action" == "unregister" ]]; then
    node "$registrar" "${args[@]}" --unregister
    return $?
  fi
  args+=(--config-file "$CONFIG_DIR/muse-squad.toml")
  node "$registrar" "${args[@]}"
}

self_update() {
  local url="$REPO_RAW_BASE/install" tmp rc
  tmp="$(mktemp "${TMPDIR:-/tmp}/muse-squad-update.XXXXXX")" || fail "mktemp failed"
  log "  fetching   $url"
  if command -v curl >/dev/null 2>&1; then
    curl -fsSL "$url" -o "$tmp" || fail "cannot download latest installer"
  elif command -v wget >/dev/null 2>&1; then
    wget -qO "$tmp" "$url" || fail "cannot download latest installer"
  else
    rm -f "$tmp"
    fail "--update requires curl or wget"
  fi
  chmod +x "$tmp" || true
  local -a args=(--dir "$CONFIG_DIR")
  (( SKIP_MCP )) && args+=(--no-mcp)
  (( SKIP_MUSE_CHECK )) && args+=(--skip-muse-check)
  [[ "$BACKUP_CHOICE" == "yes" ]] && args+=(--backup)
  [[ "$BACKUP_CHOICE" == "no" ]] && args+=(--no-backup)
  # --update skips generic reconfiguration, but a legacy config still gets the
  # one-time migration offer from the downloaded installer.
  log "  running    latest installer"
  bash "$tmp" "${args[@]}"
  rc=$?
  rm -f "$tmp"
  return $rc
}

if [[ "$MODE" != "uninstall" ]]; then
  preflight
fi

log "muse-squad v$VERSION - $MODE"
log "config dir: $CONFIG_DIR"

if [[ "$MODE" == "update" ]]; then
  self_update || exit $?
  # The downloaded installer already did the work; keep reading to EOF so a
  # piped `curl ... | bash` does not report a broken pipe.
  MODE="updated"
fi

FIRST_INSTALL=0
if [[ ! -f "$CONFIG_DIR/muse-squad.toml" ]]; then
  FIRST_INSTALL=1
fi

if [[ "$MODE" != "updated" ]]; then
  backup_config
fi

if [[ "$MODE" == "install" && "$FIRST_INSTALL" == "0" ]] && ! config_has_version_marker; then
  LEGACY_CONFIG=1
  offer_migration
fi

if [[ "$MODE" == "uninstall" ]]; then
  register_mcp unregister
  uninstall_agents_policy
  run_sync_team uninstall
  if [[ -d "$CONFIG_DIR/squad" ]]; then
    rm -rf "$CONFIG_DIR/squad" || fail "cannot remove $CONFIG_DIR/squad"
    log "  removed    $CONFIG_DIR/squad"
  fi
  uninstall_file skills/squad-team/SKILL.md
  uninstall_file skills/squad-doctor/SKILL.md
  uninstall_file skills/squad-plan/SKILL.md
  uninstall_file skills/squad-execute/SKILL.md
  uninstall_file mcp/memory.js
  uninstall_file mcp/bridge.js
  uninstall_file mcp/config.js
  uninstall_file mcp/doctor.js
  uninstall_file mcp/register-settings.js
  uninstall_file mcp/roles.js
  uninstall_file mcp/team-wizard.js
  uninstall_file mcp/sync-team.js
  uninstall_file agents/plan-reviewer.md
  uninstall_file agents/general-purpose.md
  uninstall_file agents/worker.md
  if [[ -f "$CONFIG_DIR/muse-squad.toml" ]]; then
    log "  kept       $CONFIG_DIR/muse-squad.toml (config is never removed)"
  fi
  log "done."
elif [[ "$MODE" == "updated" ]]; then
  :
else

install_file skills/squad-team/SKILL.md <<'MSQ_PAYLOAD_001'
---
name: squad-team
description: Manage the single muse-squad.toml config, its role-derived members, and the regenerated roster and wrappers.
---
You are in SQUAD-TEAM mode. Change the squad configuration and its generated outputs only.

## Read first

1. Resolve the Muse config directory: use `MUSE_CONFIG_DIR` when set, otherwise `~/.config/muse` (`%USERPROFILE%\.config\muse` on Windows).
2. Call `muse-squad:member_status` with no arguments for the roster and charters, and `muse-squad:list_providers` for provider settings. Do not use file tools to `Read` files in the Muse config directory; the sandbox rejects absolute paths outside the workspace.
3. Show the current roster briefly as `@<name> | primary | fallback chain` before asking what to change.
4. Treat `mcp/roles.js` as a read-only catalog. Do not edit it or any other file under `mcp/`.

## What you may edit

Edit only `muse-squad.toml`. Do not hand-edit `squad/team.md`, `agents/<name>.md`, `AGENTS.md` / `MUSE.md`, anything under `mcp/`, or the installer-managed `.muse-squad-state.json` beside the TOML. This is the only squad config file; there are no per-repo settings and no helper agents to edit. Apply the edit with a shell command using the resolved absolute path; file editing tools are workspace-scoped.

The file uses `schema = 1` and these tables:

- `[providers.<Name>]` — a provider name may contain letters, numbers, `.`, `_`, and `-`. `enabled` defaults to `true`; set `false` to disable the provider without removing it from member chains. `type = "native"` requires `model` and `max_concurrency`. `type = "http"` requires `base_url`, `api_key`, and `model`, and accepts `temperature`, `top_p`, `max_tokens`, `max_input_chars`, `on_context_exceeded`, `max_concurrency`, `timeout_ms`, `queue_timeout_ms`, and `max_retries`. `api_key` may be plaintext or `${ENV_VAR}`.
- `[squad.<name>]` — one per member, with only `primary`, an ordered `fallback` array, and `charter`.

Every member needs at least one provider in its chain: `primary` and every `fallback` entry must match a provider table name exactly. Validate all cross-references before writing. Never invent a provider name. Member names are lowercase slugs (`a-z0-9-`); retired helper names are reserved. Keep `schema = 1`. Do not add display names, responsibilities, labels, role IDs, or any new member keys. Use `#` for TOML comments, not `;`.

## Built-in role catalog

`mcp/roles.js` carries 20 pinned roles adapted from GitHub Squad and agency-agents (MIT), plus three locally maintained roles (`android`, `ios`, and `flutter`) grounded in official platform/Flutter documentation. Use it to generate names, charters, and templates; the TOML remains the source of truth after generation.

```bash
ROLES="$MUSE_CONFIG_DIR/mcp/roles.js"
node "$ROLES" --list
node "$ROLES" --list --category engineering
node "$ROLES" --search review
node "$ROLES" --show reviewer
node "$ROLES" --charter reviewer reviewer
node "$ROLES" --template software --json
```

On Windows without `MUSE_CONFIG_DIR`, use `node "$HOME\.config\muse\mcp\roles.js" ...`.

Templates:

- `software` — default; `lead`, `frontend`, `backend`, `reviewer`, `tester`, `devops`, `docs`.
- `engineering` — all 16 engineering, quality, operations, product, and design roles, including `android`, `ios`, and `flutter`.
- `full` — all 23 roles.
- `custom` — no preselected roles; add roles one at a time.

Every role ID is a valid member slug. Use the role ID as the default member name (`@lead`, `@backend`, `@reviewer`) unless the user asks for a rename. `--template ... --json` also includes role-aware `primary`/`fallback` suggestions; treat them as defaults and apply the user's provider choices when overriding. Generated charters include an attribution comment and the sections Identity, Ownership, How I Work, Boundaries, Routing Cues, Voice, and Delegation. Pinned roles cite the MIT-licensed upstream; the local `android`, `ios`, and `flutter` roles cite official platform/Flutter documentation. Preserve them unless the user explicitly asks for a different charter.

## Apply the change

Ask which change to make unless the user already stated it clearly:

- add, rename, or remove a provider (check every member chain before removing);
- apply a template, or add a single role by ID, number from `--list`, or category;
- rename or remove a member (at least one member must remain);
- change a member's `primary`, reorder or replace its `fallback` array, or rewrite its `charter`;
- reapply a role's charter after a rename or custom edit;
- change any provider setting, including moving a secret into `${ENV_VAR}` or setting `enabled = false` to disable a provider without removing it from member chains.

### Add from the catalog

Resolve the role with `--list`, `--show`, or `--search`, then use its ID as the member name unless another name is requested. Generate the charter with `node "$ROLES" --charter <role-id> <member-name>` and place that full text in `charter = """..."""`. Choose the provider chain from the role-aware template JSON or from the user's explicit choice. Validate every provider name before writing.

### Rename a member

Rename the `[squad.<old>]` table to `[squad.<new>]` and rewrite explicit charter tokens with a word-boundary-safe replacement: replace `@<old>` only when the next character is not `a-z0-9-`. This updates headings and delegation lines such as `# @old — ...` and `Invoke me as @old.` without changing longer names like `@old-2`. Do not attempt semantic rewriting of prose. The generated wrapper follows the TOML name; stale marked wrappers are removed by the materializer.

### Apply or reapply a template

Use `node "$ROLES" --template <template-id> --json` for the roster, provider suggestions, and full charters. If any existing member charter or custom name would be replaced, state exactly what will be overwritten and get explicit confirmation before writing. Without that confirmation, keep the current roster and charters. Applying a template is the only catalog action that may overwrite charter text.

### Manual charter edits

A user may replace a charter with their own text. Do not inject role metadata or extra TOML keys. If the user wants the catalog version back, regenerate it from the role and obtain confirmation if it will replace custom text.

Before writing, copy `muse-squad.toml` to a timestamped sibling backup such as `muse-squad.toml.bak.20261121-143022`. Apply the smallest valid TOML edit, then parse the result and re-check every provider reference. If parsing or validation fails, restore the backup and stop.

## Regenerate

Run the materializer with the same config directory:

```bash
node "$MUSE_CONFIG_DIR/mcp/sync-team.js" --config-dir "$MUSE_CONFIG_DIR"
```

On Windows without `MUSE_CONFIG_DIR`, use `node "$HOME\.config\muse\mcp\sync-team.js" --config-dir "$HOME\.config\muse"`.

If the command fails, restore the config backup, report the exact error, and do not claim success.

Stale `agents/<name>.md` wrappers that carry the generated marker are removed automatically. Leave any unmarked agent file untouched.

## Finish

Call `muse-squad:member_status` again to confirm the final roster and charters. Report the final `@<name> | primary | fallback` table, the regenerated file paths, and for each catalog change the role ID, final member name, and whether the charter was newly generated, rewritten by rename, or preserved. Never report the change as done until the materializer exited successfully.
MSQ_PAYLOAD_001
install_file skills/squad-doctor/SKILL.md <<'MSQ_PAYLOAD_002'
---
name: squad-doctor
description: Diagnose Muse Squad MCP registration, config validity, provider reachability, and roster/wrapper drift.
---
You are in SQUAD-DOCTOR mode. Diagnose only; do not change config or product code unless the user asks.

## Run the check

Resolve the Muse config directory: use `MUSE_CONFIG_DIR` when set, otherwise `~/.config/muse` (`%USERPROFILE%\.config\muse` on Windows). Run the bundled, read-only diagnostic:

```bash
node "$MUSE_CONFIG_DIR/mcp/doctor.js" --config-dir "$MUSE_CONFIG_DIR" --timeout-ms 5000
```

On Windows without `MUSE_CONFIG_DIR`, use `node "$HOME\.config\muse\mcp\doctor.js" --config-dir "$HOME\.config\muse"`. Add `--json` when a machine-readable report is useful. If `doctor.js` is missing, say the installation is incomplete and recommend re-running the installer with `--update`.

The check does not call `muse-squad` generation tools, so it still works when an HTTP provider is down. Never print API keys: report only the provider name, status, redacted hint, and, for HTTP providers, the base URL. An `api_key` read from `${ENV_VAR}` is shown only as the variable name, never its resolved value.

## What it checks

1. `settings.json` — that `mcpServers["muse-squad"]` exists, launches `node`, and points at the bundled `mcp/bridge.js` with this config directory.
2. `muse-squad.toml` — that `schema = 1`, the file parses, every provider has valid settings, and every member has `primary`, an ordered `fallback` array, and a `charter`. Every provider name in every member chain must resolve to a provider table. At least one member is required.
3. HTTP providers — a live `GET /v1/models` (or `GET /models` when `base_url` already ends in `/v1`) with a short timeout. `OK` means reachable, `AUTH` means 401/403, `HTTP` means another error status, `DOWN` / `TIMEOUT` means no answer. Native providers are reported as `native` and are not pinged; the MCP router skips them too. Providers with `enabled = false` are reported as `DISABLED`, are not pinged, and are skipped by routing and wrappers.
4. Roster and wrappers — that `squad/team.md` and every global `agents/<name>.md` match what `sync-team.js` would generate from the TOML, that only current members have generated wrappers, and that no leftover non-member agent files remain.
5. Secrets — every `api_key` is redacted in all output, including `--json`.

Exit code `0` means all checks passed, `1` means at least one check failed, and `2` means the diagnostic itself could not run.

## Recommended follow-ups

- Missing or bad `muse-squad` registration: re-run the installer, or run `node "$MUSE_CONFIG_DIR/mcp/register-settings.js"` with the installer's usual `--settings` and `--bridge` arguments.
- Config parse or cross-reference failure: fix `muse-squad.toml` with `/squad-team`. An unknown provider in a member's chain blocks that member's routing.
- `DOWN` / `TIMEOUT`: check that the HTTP model server is running, `base_url` is correct, and the port is exposed. A native provider needs no ping.
- `DISABLED`: expected when `enabled = false`; the provider is intentionally skipped. Set `enabled = true` when it should serve work again.
- `AUTH`: check that provider's `api_key` or its `${ENV_VAR}` source; never echo the key into chat.
- Roster drift or leftover wrappers: run `node "$MUSE_CONFIG_DIR/mcp/sync-team.js" --config-dir "$MUSE_CONFIG_DIR"`, or use `/squad-team` if the TOML itself needs editing.

Present a short summary table of `Check | Status | Detail`, list failing checks first, and do not claim the installation is healthy unless the diagnostic exited `0`.
MSQ_PAYLOAD_002
install_file skills/squad-plan/SKILL.md <<'MSQ_PAYLOAD_003'
---
name: squad-plan
description: Member-scoped, explore-first planning mode that writes a decision-complete plan before coding.
---
You are in SQUAD-PLAN mode. Do NOT edit product code yet.

## Named members and project memory (read first)

At startup, call `muse-squad:member_status` with no arguments to load the roster and every member's `charter`, and call `muse-squad:list_providers` for provider settings. Use only the members returned there; every step goes to a named member. Match each step to that member's `charter`. If no charter fits, ask the user which member should own the step instead of inventing a helper.

The Muse config lives in `~/.config/muse` outside the workspace. Do not use file tools to `Read` `muse-squad.toml` or `squad/team.md`; the sandbox rejects absolute paths outside the project. Use `/squad-team` when the config needs changes.

Resolve the repository root with `git rev-parse --show-toplevel`. Call `muse-squad:memory_status` with that `repo_root`; if `.muse-squad/` or any canonical file is missing, call `muse-squad:memory_init` with the same `repo_root` and `include_plan: true` before starting. Legacy `.muse/` and `.muse/squad/` memory is copied into `.muse-squad/` without deleting the originals. Every named member reads `.muse-squad/decisions.md` and `.muse-squad/history/<name>.md` before starting, and appends concise lasting learnings to its own history file when finished. Ask the documentation charter member (default `@docs`) to append durable decisions to `.muse-squad/decisions.md` before sign-off.

These `.muse-squad/` files are repository memory and should be committed with the project so other machines resume from the same plan, todo, decisions, and history. Never put API keys, absolute paths, or machine-specific provider details in them.

## TUI labels and reporting

When spawning any subagent, set its short task label exactly to:

`[<name> | <provider-name>] <concise action>`

- `<name>` is the member's lowercase name from `[squad.<name>]`.
- `<provider-name>` is the provider actually serving the step: the member's `primary` for native work, or the HTTP provider that answered through `muse-squad` for delegated work. Use the provider name exactly as written in the TOML. Never guess it from a charter or invent a model tag.
- Keep the action under ~50 characters; start with a verb; no trailing punctuation.
- Add no parenthetical text and no second field.

Examples:

```text
[lead | Muse-Spark] Review architecture
[frontend | Muse-Spark] Sketch login form changes
[backend | Muse-Ember] Map retry queue changes
[tester | Muse-Spark] List verification commands
[docs | Muse-Ember] Record plan decisions
```

Always include a "Subagents / Providers" roster in user-facing summaries and before asking for sign-off. For each entry list the member name, provider, action, and outcome. For `muse-squad` tool calls, report the member, the provider shown in tool meta, and the outcome; if meta is unavailable, say so explicitly.

## Provider limits and health (read first)

At the start, use `muse-squad:list_providers` to learn each provider's `enabled`, `max_concurrency`, `max_input_chars`, and `type`. Native providers are built into Muse and cannot be called by the MCP router; the router skips them and tries that member's HTTP providers in chain order. Providers with `enabled = false` are skipped entirely, including as a configured primary.

- Never spawn more simultaneous native subagents of one native provider than its `max_concurrency`; batch extra exploration into later waves.
- Parallel calls to `muse-squad` are safe: the router queues requests and serializes them per HTTP provider's `max_concurrency`.
- Use `muse-squad:member_status("<name>")` to inspect a member's chain before assigning a large step.

## Member-scoped routing and quota retries

`muse-squad:generate_code` and `muse-squad:critique_plan` are member-scoped:

- `generate_code(member, prompt|task_spec, context|file_context, optional system/temperature/max_tokens)`
- `critique_plan(member, plan_markdown, optional repo_context/temperature/max_tokens)`

The router resolves the named member's `primary` first, then its `fallback` providers in order. Native providers are skipped by the router; HTTP providers are tried in chain order. Disabled providers are skipped entirely, even when listed as `primary`. There is no global fallback and no silent model switching.

- **Native-primary member:** run the native subagent first. If the configured primary is disabled, skip the native turn and follow the generated wrapper's pinned provider. If it fails because of quota, rate limits, or subscription limits, retry that exact step through `muse-squad:critique_plan` (plan and review steps) or `muse-squad:generate_code` (code and diff steps) with `member="<name>"`. The router uses that member's HTTP fallbacks. Do not treat the failed native turn as the member's result.
- **HTTP-primary member:** the generated wrapper pins a native tool-runner only; it may inspect files, run checks, and apply returned diffs. Every implementation or review step must first call `muse-squad:critique_plan` (plan and review steps) or `muse-squad:generate_code` (code and diff steps) with `member="<name>"`. Do NOT author code, diffs, or review findings natively. If no tool meta is returned, the member's HTTP chain did not serve the step.

If the member chain cannot serve the request, the tool returns a hard error listing every attempt. Stop planning, report the error and its attempts verbatim, and ask the user to fix that member's chain with `/squad-team`. Do not retry with a different member, a different provider, or inline work.

## Context size

When calling `muse-squad`, keep `repo_context`, `file_context`, and `plan_markdown` short and relevant. Check the target HTTP provider's `max_input_chars` before sending; send only the needed files or excerpts. If a reply starts with the input-truncated warning, shorten the context and re-ask instead of trusting the critique.

## Planning steps

1. Map the relevant files, dependencies, and existing patterns using named members only.
2. Ask the user clarifying questions only if an architectural fork cannot be resolved from the codebase.
3. Draft a decision-complete implementation plan in `.muse-squad/PLAN.md` with exact file paths, dependency order, and verification commands. If the file already has a `## Execution Log & Decisions` section, preserve it verbatim at the bottom.
4. Plan grill: ask the architecture charter member (default `@lead`) to audit `.muse-squad/PLAN.md` against the actual files, then request an independent critique through `muse-squad:critique_plan` with `member="<name>"` for that same member. Synthesize valid issues into `.muse-squad/PLAN.md` and ask the documentation charter member (default `@docs`) to append durable choices to `.muse-squad/decisions.md`.
5. Present a summary of what was caught, including the Subagents / Providers roster, before asking the user for `/squad-execute` sign-off.
MSQ_PAYLOAD_003
install_file skills/squad-execute/SKILL.md <<'MSQ_PAYLOAD_004'
---
name: squad-execute
description: Executes the approved .muse-squad/PLAN.md with named squad members and a verification gate that blocks premature completion.
---

## Named members and project memory (read first)

At startup, call `muse-squad:member_status` with no arguments to load the roster and every member's `charter`, and call `muse-squad:list_providers` for provider settings. Use only the members returned there. All implementation and review goes through named members; there are no unnamed helpers. Match each task to a member's `charter`, and ask the user which member owns a step if no charter fits.

The Muse config lives in `~/.config/muse` outside the workspace. Do not use file tools to `Read` `muse-squad.toml` or `squad/team.md`; the sandbox rejects absolute paths outside the project. Use `/squad-team` when the config needs changes.

Resolve the repository root with `git rev-parse --show-toplevel`. Call `muse-squad:memory_status` with that `repo_root`; if `.muse-squad/` or any canonical file is missing, call `muse-squad:memory_init` with the same `repo_root` and `include_plan: true` before starting. Legacy `.muse/` and `.muse/squad/` memory is copied into `.muse-squad/` without deleting the originals. Every member reads `.muse-squad/decisions.md` and `.muse-squad/history/<name>.md` before work and appends concise lasting learnings when finished.

These `.muse-squad/` files are repository memory and should be committed with the project so other machines resume from the same plan, todo, decisions, and history. Never put API keys, absolute paths, or machine-specific provider details in them. Use isolated Git worktrees for bounded implementation tasks where available.

## TUI labels and reporting

When spawning any subagent, set its short task label exactly to:

`[<name> | <provider-name>] <concise action>`

- `<name>` is the member's lowercase name from `[squad.<name>]`.
- `<provider-name>` is the provider actually serving the step: the member's `primary` for native work, or the HTTP provider that answered through `muse-squad` for delegated work. Use the provider name exactly as written in the TOML; never guess it from a charter or invent a model tag.
- Keep the action under ~50 characters; start with a verb; no trailing punctuation.
- Add no parenthetical text and no second field.

Examples:

```text
[lead | Muse-Spark] Sequence wave dependencies
[frontend | Muse-Spark] Build login form
[backend | Muse-Ember] Add retry queue
[tester | Muse-Spark] Run regression suite
[docs | Muse-Ember] Log wave decisions
```

Always include a "Subagents / Providers" roster in wave, progress, and completion summaries. For each entry list the member name, provider, action, and outcome. For `muse-squad` tool calls, report the member, the provider shown in tool meta, and the outcome; if meta is unavailable, say so explicitly. When practical, include the member name and provider in execution-log entries.

## Provider limits, health, and member-scoped routing (read first)

At the start, use `muse-squad:list_providers` to learn each provider's `enabled`, `type`, `max_concurrency`, and `max_input_chars`. Use `muse-squad:member_status("<name>")` to inspect a member's chain before assigning work. Native providers are built into Muse and cannot be called by the MCP router; the router skips them and tries that member's HTTP providers in chain order. Providers with `enabled = false` are skipped entirely, including as a configured primary.

`muse-squad:generate_code` and `muse-squad:critique_plan` are member-scoped:

- `generate_code(member, prompt|task_spec, context|file_context, optional system/temperature/max_tokens)`
- `critique_plan(member, plan_markdown, optional repo_context/temperature/max_tokens)`

The router resolves the named member's `primary` first, then its `fallback` providers in order. Disabled providers are skipped entirely, even when listed as `primary`. There is no global fallback and no silent model switching.

- **Native-primary member:** run the native subagent first. If the configured primary is disabled, skip the native turn and follow the generated wrapper's pinned provider. If it fails because of quota, rate limits, or subscription limits, retry that exact step through `muse-squad:generate_code` (implementation steps) or `muse-squad:critique_plan` (reviews) with `member="<name>"`. The router uses that member's HTTP fallbacks. Do not treat the failed native turn as the member's result.
- **HTTP-primary member:** the generated wrapper pins a native tool-runner only; it may inspect files, run checks, and apply returned diffs. Every implementation or review step must first call `muse-squad:generate_code` (implementation) or `muse-squad:critique_plan` (reviews) with `member="<name>"`. Do NOT author code, diffs, or review findings natively. If no tool meta is returned, the member's HTTP chain did not serve the step.
- Parallel calls to `muse-squad` are safe: the router queues requests and serializes them per HTTP provider's `max_concurrency`. Do not add separate locking in members.

**Errors stop the wave.** If any member chain returns a hard error, stop the current wave immediately, report the error and every attempted provider verbatim, and ask the user to fix that member's chain with `/squad-team`. Do not retry with a different member, a different provider, or inline work, and do not advance to the next wave.

## Context size

Before each `generate_code` call, check the target HTTP provider's `max_input_chars`. Keep `file_context` (and any `repo_context`) to the smallest excerpts that explain the change — no whole-file dumps, logs, or unrelated tests. If the reply starts with the input-truncated warning, shorten the context and re-ask; do not apply a diff generated from cut-off context.

## Patch discipline (diffs, not full rewrites)

- Ask `generate_code` for a targeted unified diff (`git apply` format) for existing files. A single targeted function or block with its path and line range is acceptable when a diff is impractical; a full-file rewrite is not.
- The orchestrator applies each hunk surgically with native edit tools, preserving the rest of the file. For an HTTP-primary member, the orchestrator is only the tool-runner: the hunk must come from `generate_code` with `member="<name>"`; it may not author the hunk itself. Do not overwrite whole files with generated output.
- Reject and re-prompt if the result is a full file, truncated content, `...`/placeholders, or an unapplyable diff. Never repair omitted code by guessing.
- Run the fastest incremental check on changed files, then the Verification Gate after applying patches.

## Verification gate (do not stop until verified)

You are not done and must not return control to the user while any `.muse-squad/TODO.md` item is unchecked or while any verification command fails.

Read `.muse-squad/PLAN.md`, including any existing `## Execution Log & Decisions` section; it is the durable handoff record when resuming a long or interrupted session. Group independent tasks into successive waves. After every wave — before advancing and before reporting completion:

1. Update `.muse-squad/TODO.md` (create it from the plan if it does not exist). Check off only items whose changes are applied and verified; leave or add `- [ ]` items for remaining or newly discovered work. Record exact verification commands and results in the checklist.
2. Run every verification command listed in `.muse-squad/PLAN.md` from the repository root — for example `npm test`, `cargo check`, `pytest`, or `go test ./...`. If the plan lists none, detect the project's typechecker and test commands from its manifests, add them to `.muse-squad/TODO.md`, and run them.
3. If any command fails, fix the failure in another bounded wave with the appropriate named member and repeat this gate. Never mark an item done or claim success based on a partial pass.
4. Append a short entry to `## Execution Log & Decisions` at the bottom of `.muse-squad/PLAN.md` (create the section if absent). Record the wave number, what landed, decisions and *why*, gotchas discovered, exact verification commands and results, and any remaining work or blockers. Append only — never rewrite or delete earlier entries. Ask the documentation charter member (default `@docs`) to append durable decisions to `.muse-squad/decisions.md` and each member to append lasting learnings to its own `.muse-squad/history/<name>.md`.
5. Only when all TODO items are checked and all verification commands pass, summarize what was verified and return control to the user, including the Subagents / Providers roster for the run.

## Session handoff notes

The `## Execution Log & Decisions` section in `.muse-squad/PLAN.md` is authoritative state, not chat history. Keep entries short (a few bullets per wave) and append-only:

```markdown
## Execution Log & Decisions

### Wave 2 - 2026-11-21
- Landed: retry/backoff in mcp/bridge.js; TOML defaults refreshed.
- Decision: 4xx is non-retryable - an invalid key must fail fast, not burn chain attempts. Reason: silent auth failures wasted a wave earlier.
- Gotcha: fallback notices belong in MCP `meta`, not tool text, or `git apply` breaks.
- Verified: `node --check mcp/bridge.js` PASS; `npm test` PASS.
- Remaining: Windows installer still untested locally (no pwsh).
```

On resume, read this section first and continue from the last entry instead of re-deriving decisions from scratch. If a later wave reverses a decision, append a new entry saying so with the reason — do not edit history.
