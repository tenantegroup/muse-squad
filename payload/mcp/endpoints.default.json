{
  "schema_version": 1,
  "default": "local-coder",
  "fallback_order": ["local-coder", "grill-reviewer"],
  "muse_models": {
    "muse-ember-1.0": 4,
    "muse-spark-1.3": 2
  },
  "timeout_ms": 600000,
  "queue_timeout_ms": 300000,
  "max_retries": 2,
  "endpoints": {
    "local-coder": {
      "base_url": "http://127.0.0.1:8000/v1",
      "api_key": "local-key",
      "model": "local-llama/Ornith-1.5-35B-A3B-MLX-4bit",
      "temperature": 0.2,
      "max_concurrency": 1,
      "max_tokens": 8192,
      "max_input_chars": 96000,
      "extra_body": { "top_p": 0.9 },
      "on_context_exceeded": "truncate"
    },
    "grill-reviewer": {
      "base_url": "http://127.0.0.1:8000/v1",
      "api_key": "local-key",
      "model": "ornith-1.5-35b",
      "temperature": 0.3,
      "max_concurrency": 1,
      "max_tokens": 4096,
      "max_input_chars": 96000,
      "extra_body": { "top_p": 0.9 },
      "on_context_exceeded": "truncate"
    }
  }
}
